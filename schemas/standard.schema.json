{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentForge Standard — Foundation 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard_version", "commandments"],
  "properties": {
    "standard_version": {"const": "0.1"},
    "commandments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["M1", "M2", "M3", "M4", "M5"],
      "properties": {
        "M1": {"$ref": "#/$defs/commandment"},
        "M2": {"$ref": "#/$defs/commandment"},
        "M3": {"$ref": "#/$defs/commandment"},
        "M4": {"$ref": "#/$defs/commandment"},
        "M5": {"$ref": "#/$defs/commandment"}
      }
    }
  },
  "$defs": {
    "commandment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "description"],
      "properties": {
        "required": {"type": "boolean", "const": true},
        "description": {"type": "string", "pattern": "\\S"}
      }
    }
  }
}
