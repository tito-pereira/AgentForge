{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/work-report-result.schema.json",
  "type": "object",
  "properties": {
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "maxItems": 8
    },
    "affected_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "module_ref": {
            "anyOf": [
              {
                "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "module_id",
          "module_ref"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^work-[0-9a-f]{32}$"
      },
      "maxItems": 16
    },
    "flow": {
      "$ref": "https://schemas.corinthos.local/rpc/v2/adaptive-flow-result.schema.json"
    },
    "scope_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "occurred_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "data": {
            "type": "object",
            "properties": {
              "work_item_id": {
                "type": "string",
                "pattern": "^work-[0-9a-f]{32}$"
              },
              "old_scope": {
                "enum": [
                  "TASK",
                  "CHANGE",
                  "PROJECT",
                  "CRITICAL"
                ]
              },
              "new_scope": {
                "enum": [
                  "TASK",
                  "CHANGE",
                  "PROJECT",
                  "CRITICAL"
                ]
              },
              "updated_at": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "policy_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "confirm_downgrade": {
                "type": "boolean"
              }
            },
            "required": [
              "work_item_id",
              "old_scope",
              "new_scope",
              "updated_at",
              "policy_version",
              "confirm_downgrade"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "actor_id",
          "occurred_at",
          "data"
        ],
        "additionalProperties": false
      },
      "maxItems": 12
    },
    "evidence_report_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
      },
      "maxItems": 12
    },
    "overall_status": {
      "enum": [
        "VERIFIED",
        "NOT_VERIFIED",
        "BLOCKED"
      ]
    }
  },
  "required": [
    "work_item_id",
    "objective",
    "acceptance_criteria",
    "affected_modules",
    "dependencies",
    "flow",
    "scope_history",
    "evidence_report_refs",
    "overall_status"
  ],
  "additionalProperties": false
}
