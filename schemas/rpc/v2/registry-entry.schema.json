{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/registry-entry.schema.json",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "last_accessed_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "availability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "UNAVAILABLE"
      ]
    },
    "initialized": {
      "type": "boolean"
    },
    "storage": {
      "enum": [
        "ABSENT",
        "CURRENT",
        "LEGACY",
        "INVALID",
        "UNVERIFIED"
      ]
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "root",
    "display_name",
    "last_accessed_at",
    "availability",
    "initialized",
    "storage",
    "schema_version"
  ]
}
