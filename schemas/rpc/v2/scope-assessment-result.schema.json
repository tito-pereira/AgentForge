{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/scope-assessment-result.schema.json",
  "type": "object",
  "properties": {
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "selected_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "recommended_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "minimum_required_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 20
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 20
    },
    "downgrade_requires_confirmation": {
      "type": "boolean"
    },
    "effective_flow": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "work_item_id",
    "selected_scope",
    "recommended_scope",
    "minimum_required_scope",
    "signals",
    "unknowns",
    "downgrade_requires_confirmation",
    "effective_flow",
    "policy_version",
    "updated_at"
  ],
  "additionalProperties": false
}
