{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/project-summary-result.schema.json",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "last_accessed_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "exists": {
      "type": "boolean"
    },
    "is_directory": {
      "type": "boolean"
    },
    "initialized": {
      "type": "boolean"
    },
    "storage": {
      "enum": [
        "ABSENT",
        "CURRENT",
        "LEGACY",
        "INVALID",
        "UNVERIFIED"
      ]
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_project": {
      "anyOf": [
        {
          "$ref": "contract-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "active_workflow": {
      "anyOf": [
        {
          "$ref": "contract-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "contract-reference.schema.json"
      },
      "maxItems": 16
    },
    "validation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "state": {
              "enum": [
                "RUNNING",
                "FROZEN",
                "PUBLISHED"
              ]
            },
            "plan": {
              "$ref": "contract-reference.schema.json"
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "contract-reference.schema.json"
                },
                {
                  "type": "null"
                }
              ]
            },
            "plan_is_active": {
              "type": "boolean"
            }
          },
          "required": [
            "run_id",
            "state",
            "plan",
            "result",
            "plan_is_active"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "lifecycle": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tracker_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            "enabled": {
              "type": "boolean"
            },
            "active_build_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "pending_build_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "tracker_id",
            "enabled",
            "active_build_id",
            "pending_build_id",
            "version"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "work_items": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "by_status": {
              "type": "object",
              "properties": {
                "OPEN": {
                  "type": "integer",
                  "minimum": 0
                },
                "ACTIVE": {
                  "type": "integer",
                  "minimum": 0
                },
                "BLOCKED": {
                  "type": "integer",
                  "minimum": 0
                },
                "COMPLETED": {
                  "type": "integer",
                  "minimum": 0
                },
                "CANCELLED": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "OPEN",
                "ACTIVE",
                "BLOCKED",
                "COMPLETED",
                "CANCELLED"
              ]
            },
            "by_scope": {
              "type": "object",
              "properties": {
                "TASK": {
                  "type": "integer",
                  "minimum": 0
                },
                "CHANGE": {
                  "type": "integer",
                  "minimum": 0
                },
                "PROJECT": {
                  "type": "integer",
                  "minimum": 0
                },
                "CRITICAL": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "TASK",
                "CHANGE",
                "PROJECT",
                "CRITICAL"
              ]
            }
          },
          "required": [
            "total",
            "by_status",
            "by_scope"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "unavailable_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      },
      "maxItems": 16
    },
    "technology_decisions": {
      "type": "array",
      "items": {
        "$ref": "contract-reference.schema.json"
      },
      "maxItems": 16
    }
  },
  "required": [
    "root",
    "display_name",
    "last_accessed_at",
    "exists",
    "is_directory",
    "initialized",
    "storage",
    "schema_version",
    "project_id",
    "active_project",
    "active_workflow",
    "modules",
    "validation",
    "lifecycle",
    "work_items",
    "unavailable_sources",
    "technology_decisions"
  ]
}
