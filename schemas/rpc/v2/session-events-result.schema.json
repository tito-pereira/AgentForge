{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/session-events-result.schema.json",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "session-event.schema.json"
      }
    },
    "next_after_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "events",
    "next_after_sequence"
  ]
}
