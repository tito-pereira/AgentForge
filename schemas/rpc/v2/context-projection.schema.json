{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/context-projection.schema.json",
  "type": "object",
  "properties": {
    "projection_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "target_provider": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "selector_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "redaction_policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "projection_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_set_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    }
  },
  "required": [
    "projection_id",
    "project_id",
    "work_item_id",
    "target_provider",
    "selector_policy_version",
    "redaction_policy_version",
    "projection_digest",
    "source_set_digest",
    "created_at"
  ],
  "additionalProperties": false
}
