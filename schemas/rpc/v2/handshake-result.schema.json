{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/handshake-result.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    }
  },
  "required": [
    "protocol_version",
    "version",
    "methods"
  ]
}
