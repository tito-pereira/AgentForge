{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/session-list-result.schema.json",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "$ref": "session-result.schema.json"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sessions",
    "limit",
    "offset",
    "next_offset"
  ]
}
