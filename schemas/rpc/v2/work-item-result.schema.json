{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/work-item-result.schema.json",
  "type": "object",
  "properties": {
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope_level": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "parent_work_item_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^work-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "maxItems": 8,
      "minItems": 1
    },
    "status": {
      "enum": [
        "OPEN",
        "ACTIVE",
        "BLOCKED",
        "COMPLETED",
        "CANCELLED"
      ]
    },
    "validation_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "provenance": {
      "type": "object",
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "source": {
          "const": "LOCAL_OPERATOR"
        }
      },
      "required": [
        "actor_id",
        "source"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "type": "null"
        }
      ]
    },
    "affected_modules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "module_ref": {
            "anyOf": [
              {
                "$ref": "contract-reference.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "module_id",
          "module_ref"
        ]
      },
      "maxItems": 12
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^work-[0-9a-f]{32}$"
      },
      "maxItems": 16
    },
    "allowed_transitions": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OPEN",
          "ACTIVE",
          "BLOCKED",
          "COMPLETED",
          "CANCELLED"
        ]
      }
    }
  },
  "required": [
    "work_item_id",
    "project_id",
    "scope_level",
    "parent_work_item_id",
    "objective",
    "acceptance_criteria",
    "status",
    "validation_policy",
    "provenance",
    "created_at",
    "updated_at",
    "completed_at",
    "affected_modules",
    "dependencies",
    "allowed_transitions"
  ]
}
