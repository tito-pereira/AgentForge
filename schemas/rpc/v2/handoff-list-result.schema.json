{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/handoff-list-result.schema.json",
  "type": "object",
  "properties": {
    "handoffs": {
      "type": "array",
      "maxItems": 25,
      "items": {
        "type": "object",
        "properties": {
          "handoff_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "project_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "work_item_id": {
            "type": "string",
            "pattern": "^work-[0-9a-f]{32}$"
          },
          "source_session_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "run_generation": {
            "type": "integer",
            "minimum": 1
          },
          "event_cutoff": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "provider": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          },
          "terminal_state": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "CANCELLED",
              "TIMED_OUT",
              "INTERRUPTED"
            ]
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1
          }
        },
        "required": [
          "handoff_id",
          "project_id",
          "work_item_id",
          "source_session_id",
          "run_generation",
          "event_cutoff",
          "provider",
          "terminal_state",
          "digest",
          "created_at"
        ],
        "additionalProperties": false
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "handoffs",
    "limit",
    "offset",
    "next_offset"
  ],
  "additionalProperties": false
}
