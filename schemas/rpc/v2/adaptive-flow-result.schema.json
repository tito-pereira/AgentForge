{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/adaptive-flow-result.schema.json",
  "type": "object",
  "properties": {
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "selected_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "recommended_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "minimum_required_scope": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 20
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 20
    },
    "downgrade_requires_confirmation": {
      "type": "boolean"
    },
    "effective_flow": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "flow_kind": {
      "enum": [
        "TASK",
        "CHANGE",
        "PROJECT",
        "CRITICAL"
      ]
    },
    "stage": {
      "enum": [
        "TERMINAL",
        "BLOCKED_SCOPE",
        "EXECUTING",
        "BLOCKED",
        "PLANNING_REQUIRED",
        "WORKFLOW_READY",
        "COMPLETION_READY",
        "VALIDATION_REQUIRED",
        "READY"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "state": {
            "enum": [
              "SATISFIED",
              "REQUIRED",
              "VERIFIED",
              "NOT_VERIFIED",
              "BLOCKED"
            ]
          }
        },
        "required": [
          "id",
          "state"
        ],
        "additionalProperties": false
      },
      "maxItems": 20
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "maxItems": 20
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 640
      },
      "maxItems": 20
    },
    "validation_state": {
      "enum": [
        "VERIFIED",
        "NOT_VERIFIED",
        "BLOCKED"
      ]
    },
    "validation_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "validation_result_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
      },
      "maxItems": 24
    },
    "project_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_ref": {
      "anyOf": [
        {
          "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "execution": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "execution_id": {
              "type": "string",
              "pattern": "^execution-[0-9a-f]{32}$"
            },
            "state": {
              "enum": [
                "ACTIVE",
                "COMPLETED",
                "BLOCKED",
                "INTERRUPTED",
                "SUPERSEDED"
              ]
            },
            "version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "workflow_ref": {
              "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
            },
            "workflow_approval_kind": {
              "enum": [
                "HUMAN",
                "DELEGATED",
                null
              ]
            },
            "work_item": {
              "type": "object",
              "properties": {
                "work_item_id": {
                  "type": "string",
                  "pattern": "^work-[0-9a-f]{32}$"
                },
                "content_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "work_item_id",
                "content_sha256"
              ],
              "additionalProperties": false
            },
            "binding_current": {
              "type": "boolean"
            },
            "has_claim": {
              "type": "boolean"
            },
            "checkpoints": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "checkpoint_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                "workflow_ref": {
                  "$ref": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                  "state": {
                    "enum": [
                      "PENDING",
                      "READY",
                      "RUNNING",
                      "VERIFYING",
                      "COMPLETED",
                      "BLOCKED",
                      "INTERRUPTED"
                    ]
                  },
                  "attempt_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^attempt-[0-9a-f]{32}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "inherited_from": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "execution_id": {
                            "type": "string",
                            "pattern": "^execution-[0-9a-f]{32}$"
                          },
                          "checkpoint_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "attempt_id": {
                            "anyOf": [
                              {
                                "type": "string",
                                "pattern": "^attempt-[0-9a-f]{32}$"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          }
                        },
                        "required": [
                          "execution_id",
                          "checkpoint_id",
                "attempt_id",
                "workflow_ref",
                "reason"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "checkpoint_id",
                  "state",
                  "attempt_id",
                  "inherited_from"
                ],
                "additionalProperties": false
              },
              "maxItems": 25
            },
            "checkpoints_truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "execution_id",
            "state",
            "version",
            "workflow_ref",
            "workflow_approval_kind",
            "work_item",
            "binding_current",
            "has_claim",
            "checkpoints",
            "checkpoints_truncated"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_session": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "pattern": "^session-[0-9a-f]{32}$"
            },
            "provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "state": {
              "enum": [
                "STARTING",
                "RUNNING",
                "CANCELLING",
                "SUCCEEDED",
                "FAILED",
                "CANCELLED",
                "TIMED_OUT",
                "INTERRUPTED"
              ]
            },
            "run_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "context_projection_id": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^projection-[0-9a-f]{32}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cleanup_unconfirmed": {
              "type": "boolean"
            }
          },
          "required": [
            "session_id",
            "provider",
            "state",
            "run_generation",
            "context_projection_id",
            "cleanup_unconfirmed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_projection": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "projection_id": {
              "type": "string",
              "pattern": "^projection-[0-9a-f]{32}$"
            },
            "projection_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "projection_id",
            "projection_digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "latest_handoff": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "handoff_id": {
              "type": "string",
              "pattern": "^handoff-[0-9a-f]{32}$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "handoff_id",
            "digest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_continuity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "source_session_id": {
              "type": "string",
              "pattern": "^session-[0-9a-f]{32}$"
            },
            "source_generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "source_provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "handoff_id": {
              "type": "string",
              "pattern": "^handoff-[0-9a-f]{32}$"
            },
            "target_session_id": {
              "type": "string",
              "pattern": "^session-[0-9a-f]{32}$"
            },
            "target_provider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "projection_id": {
              "type": "string",
              "pattern": "^projection-[0-9a-f]{32}$"
            }
          },
          "required": [
            "source_session_id",
            "source_generation",
            "source_provider",
            "handoff_id",
            "target_session_id",
            "target_provider",
            "projection_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "can_start": {
      "type": "boolean"
    },
    "can_complete": {
      "type": "boolean"
    },
    "report_status": {
      "enum": [
        "VERIFIED",
        "NOT_VERIFIED",
        "BLOCKED"
      ]
    }
  },
  "required": [
    "work_item_id",
    "selected_scope",
    "recommended_scope",
    "minimum_required_scope",
    "signals",
    "unknowns",
    "downgrade_requires_confirmation",
    "effective_flow",
    "policy_version",
    "updated_at",
    "flow_kind",
    "stage",
    "gates",
    "blockers",
    "next_actions",
    "validation_state",
    "validation_policy",
    "validation_result_refs",
    "project_ref",
    "workflow_ref",
    "execution",
    "latest_session",
    "latest_projection",
    "latest_handoff",
    "provider_continuity",
    "can_start",
    "can_complete",
    "report_status"
  ],
  "additionalProperties": false
}
