{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/context-source.schema.json",
  "type": "object",
  "properties": {
    "ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 256
    },
    "kind": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "authority": {
      "enum": [
        "CANONICAL",
        "OPERATIONAL",
        "DERIVED"
      ]
    },
    "identity": {
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "redaction": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "maxLength": 64,
        "minLength": 1
      }
    }
  },
  "required": [
    "ordinal",
    "kind",
    "authority",
    "identity",
    "revision",
    "digest",
    "reason",
    "redaction"
  ],
  "additionalProperties": false
}
