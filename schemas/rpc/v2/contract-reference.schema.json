{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/contract-reference.schema.json",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "contract_type": {
      "enum": [
        "PROJECT",
        "WORKFLOW",
        "MODULE",
        "TECHNOLOGY_DECISION",
        "VALIDATION",
        "VALIDATION_RESULT",
        "EVIDENCE_REPORT",
        "PROJECT_REVISION_REQUEST"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  },
  "required": [
    "contract_id",
    "revision_id",
    "contract_type",
    "project_id"
  ]
}
