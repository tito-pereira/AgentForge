{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/switch-result.schema.json",
  "type": "object",
  "properties": {
    "switch_key": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "source_session_id": {
      "type": "string",
      "pattern": "^session-[0-9a-f]{32}$"
    },
    "source_provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_state": {
      "enum": [
        "STARTING",
        "RUNNING",
        "CANCELLING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT",
        "INTERRUPTED"
      ]
    },
    "cleanup_unconfirmed": {
      "type": "boolean"
    },
    "target_provider": {
      "enum": [
        "codex",
        "claude"
      ]
    },
    "stage": {
      "enum": [
        "SOURCE_ACTIVE",
        "STOPPING_SOURCE",
        "SOURCE_TERMINAL",
        "HANDOFF_READY",
        "PROJECTION_READY",
        "TARGET_SESSION_ACTIVE",
        "TARGET_SESSION_TERMINAL",
        "BLOCKED"
      ]
    },
    "handoff_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^handoff-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "handoff_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "projection_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^projection-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "projection_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^session-[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_state": {
      "anyOf": [
        {
          "enum": [
            "STARTING",
            "RUNNING",
            "CANCELLING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "TIMED_OUT",
            "INTERRUPTED"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "blocker": {
      "enum": [
        null,
        "TARGET_UNAVAILABLE",
        "TARGET_UNSUPPORTED",
        "SOURCE_CLEANUP_UNCONFIRMED",
        "PROJECT_SESSION_ACTIVE",
        "WORK_ITEM_CLOSED",
        "SOURCE_LEASE_EXPIRED"
      ]
    }
  },
  "required": [
    "switch_key",
    "project_id",
    "work_item_id",
    "source_session_id",
    "source_provider",
    "source_generation",
    "source_state",
    "cleanup_unconfirmed",
    "target_provider",
    "stage",
    "handoff_id",
    "handoff_digest",
    "projection_id",
    "projection_digest",
    "target_session_id",
    "target_state",
    "blocker"
  ],
  "additionalProperties": false
}
