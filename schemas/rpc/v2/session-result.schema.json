{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/session-result.schema.json",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "project_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "work_item_id": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{32}$"
    },
    "provider": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provider_version": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 128,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "enum": [
        "STARTING",
        "RUNNING",
        "CANCELLING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "TIMED_OUT",
        "INTERRUPTED"
      ]
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "input_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "output_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "cached_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "duration_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reported_cost": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9]+(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reported_cost_currency": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "read_only": {
      "type": "boolean"
    },
    "cleanup_unconfirmed": {
      "type": "boolean"
    },
    "can_cancel": {
      "type": "boolean"
    },
    "can_recover": {
      "type": "boolean"
    }
  },
  "required": [
    "session_id",
    "project_id",
    "work_item_id",
    "provider",
    "provider_version",
    "model",
    "state",
    "run_generation",
    "created_at",
    "updated_at",
    "started_at",
    "finished_at",
    "input_tokens",
    "output_tokens",
    "cached_tokens",
    "duration_ms",
    "reported_cost",
    "reported_cost_currency",
    "timeout_seconds",
    "read_only",
    "cleanup_unconfirmed",
    "can_cancel",
    "can_recover"
  ]
}
