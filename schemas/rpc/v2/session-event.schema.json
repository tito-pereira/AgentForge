{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/session-event.schema.json",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "kind": {
      "enum": [
        "SESSION_CREATED",
        "SESSION_STARTED",
        "OUTPUT",
        "TOOL_ACTIVITY",
        "USAGE",
        "WARNING",
        "ERROR",
        "SESSION_FINISHED",
        "CANCEL_REQUESTED",
        "CANCELLED",
        "TIMED_OUT",
        "INTERRUPTED",
        "RECOVERY_STARTED"
      ]
    },
    "occurred_at": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "maxProperties": 64
    },
    "native_kind": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 96,
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "run_generation": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "session_id",
    "sequence",
    "kind",
    "occurred_at",
    "payload",
    "native_kind",
    "run_generation"
  ]
}
