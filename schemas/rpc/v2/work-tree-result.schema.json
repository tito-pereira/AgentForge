{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v2/work-tree-result.schema.json",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "work_item_id": {
            "type": "string",
            "pattern": "^work-[0-9a-f]{32}$"
          },
          "parent_work_item_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^work-[0-9a-f]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "depth": {
            "type": "integer",
            "minimum": 0
          },
          "scope_level": {
            "enum": [
              "TASK",
              "CHANGE",
              "PROJECT",
              "CRITICAL"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "ACTIVE",
              "BLOCKED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": [
          "work_item_id",
          "parent_work_item_id",
          "depth",
          "scope_level",
          "status",
          "objective"
        ]
      },
      "maxItems": 25
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "nodes",
    "limit",
    "offset",
    "next_offset"
  ]
}
