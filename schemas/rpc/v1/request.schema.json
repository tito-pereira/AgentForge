{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v1/request.schema.json",
  "type": "object",
  "properties": {
    "jsonrpc": {
      "const": "2.0"
    },
    "id": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "maxLength": 128
        }
      ]
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "jsonrpc",
    "method"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "system.handshake"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "protocol_version": {
                "type": "integer"
              }
            },
            "required": [
              "protocol_version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "system.version"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "project.status"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [
              "root"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "params"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "providers.status"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "system.shutdown"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          }
        },
        "required": []
      }
    }
  ]
}
