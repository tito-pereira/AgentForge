{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v1/handshake-result.schema.json",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "methods": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "enum": [
          "system.handshake",
          "system.version",
          "project.status",
          "providers.status",
          "system.shutdown"
        ]
      }
    }
  },
  "required": [
    "protocol_version",
    "version",
    "methods"
  ],
  "additionalProperties": false
}
