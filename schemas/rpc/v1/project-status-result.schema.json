{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v1/project-status-result.schema.json",
  "type": "object",
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "exists": {
      "type": "boolean"
    },
    "is_directory": {
      "type": "boolean"
    },
    "initialized": {
      "type": "boolean"
    },
    "storage": {
      "enum": [
        "ABSENT",
        "CURRENT",
        "LEGACY",
        "INVALID",
        "UNVERIFIED"
      ]
    },
    "schema_version": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "root",
    "exists",
    "is_directory",
    "initialized",
    "storage",
    "schema_version"
  ],
  "additionalProperties": false
}
