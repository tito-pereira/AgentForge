{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.corinthos.local/rpc/v1/provider-status-result.schema.json",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "maxItems": 34,
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "supported": {
            "type": "boolean"
          },
          "configuration": {
            "enum": [
              "operational",
              "initial",
              "global",
              "default"
            ]
          },
          "executable": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          },
          "observation": {
            "enum": [
              "OBSERVED",
              "NOT_OBSERVED",
              "UNKNOWN"
            ]
          },
          "capabilities": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "available": {
                    "type": "boolean"
                  },
                  "json_events": {
                    "type": "boolean"
                  },
                  "stdin_prompt": {
                    "type": "boolean"
                  },
                  "native_resume": {
                    "type": "boolean"
                  },
                  "read_only": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "version",
                  "available",
                  "json_events",
                  "stdin_prompt",
                  "native_resume",
                  "read_only"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "provider",
          "supported",
          "configuration",
          "executable",
          "observation",
          "capabilities"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "providers"
  ],
  "additionalProperties": false
}
