{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:workflow",
  "title": "Corinthos Workflow Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "WORKFLOW"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "WORKFLOW"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "properties": {
        "module_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "module_contract_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "MODULE"
              ]
            }
          }
        },
        "requirement_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "depends_on": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        }
      },
      "required": [
        "module_id",
        "module_contract_ref",
        "requirement_ids",
        "depends_on"
      ],
      "additionalProperties": false
    },
    "technology_decision": {
      "type": "object",
      "properties": {
        "module_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "decision_contract_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "TECHNOLOGY_DECISION"
              ]
            }
          }
        }
      },
      "required": [
        "module_id",
        "decision_contract_ref"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "checkpoint_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "title": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "objective": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "module_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "requirement_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "depends_on": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "deliverables": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "completion_criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/criterion"
          },
          "minItems": 1
        },
        "verification_plan": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        }
      },
      "required": [
        "checkpoint_id",
        "title",
        "objective",
        "module_ids",
        "requirement_ids",
        "depends_on",
        "deliverables",
        "completion_criteria",
        "verification_plan"
      ],
      "additionalProperties": false
    },
    "milestone": {
      "type": "object",
      "properties": {
        "milestone_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "title": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "objective": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "depends_on": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "required_checkpoint_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "test_scope": {
          "type": "object",
          "properties": {
            "included": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
            },
            "excluded": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "included",
            "excluded"
          ],
          "additionalProperties": false
        },
        "test_scenarios": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "readiness_criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/criterion"
          },
          "minItems": 1
        }
      },
      "required": [
        "milestone_id",
        "title",
        "objective",
        "depends_on",
        "required_checkpoint_ids",
        "test_scope",
        "test_scenarios",
        "readiness_criteria"
      ],
      "additionalProperties": false
    },
    "execution_policy": {
      "type": "object",
      "properties": {
        "scheduling_policy": {
          "const": "DEPENDENCY_AWARE"
        },
        "validation_policy": {
          "const": "REQUIRED_GATES"
        },
        "recovery_policy": {
          "const": "PERSISTENT_STATE"
        },
        "build_policy": {
          "const": "CUMULATIVE_SINGLE_ACTIVE"
        }
      },
      "required": [
        "scheduling_policy",
        "validation_policy",
        "recovery_policy",
        "build_policy"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "project_contract_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "PROJECT"
              ]
            }
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/module"
          },
          "minItems": 1
        },
        "technology_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/technology_decision"
          }
        },
        "checkpoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkpoint"
          },
          "minItems": 1
        },
        "playtest_milestones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/milestone"
          }
        },
        "execution_policy": {
          "$ref": "#/$defs/execution_policy"
        }
      },
      "required": [
        "project_contract_ref",
        "modules",
        "technology_decisions",
        "checkpoints",
        "playtest_milestones",
        "execution_policy"
      ],
      "additionalProperties": false
    }
  }
}
