{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:validation-result",
  "title": "Corinthos Validation Result Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "VALIDATION_RESULT"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "VALIDATION"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "target_and_execution": {
      "type": "object",
      "properties": {
        "validation_run_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "trigger": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "started_at": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/date_time"
        },
        "finished_at": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/date_time"
            },
            {
              "type": "null"
            }
          ]
        },
        "artifact_identity": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/artifact_identity"
        },
        "environment": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "tool_versions": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "configuration": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "evaluator_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "status": {
          "enum": [
            "COMPLETED",
            "INTERRUPTED",
            "ERROR"
          ]
        }
      },
      "required": [
        "validation_run_id",
        "trigger",
        "started_at",
        "finished_at",
        "artifact_identity",
        "environment",
        "tool_versions",
        "configuration",
        "evaluator_ref",
        "status"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": "COMPLETED"
          }
        }
      },
      "then": {
        "properties": {
          "finished_at": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/date_time"
          }
        }
      }
    },
    "check_result": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
        },
        "verification_method": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "status": {
          "enum": [
            "CONFORMANT",
            "NONCONFORMANT",
            "NOT_VERIFIED",
            null
          ]
        },
        "evidence_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "rationale": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "not_applicable_reason": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "check_id",
        "source_ref",
        "verification_method",
        "status",
        "evidence_ids",
        "rationale"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "status": {
            "const": null
          }
        }
      },
      "then": {
        "required": [
          "not_applicable_reason"
        ]
      },
      "else": {
        "not": {
          "required": [
            "not_applicable_reason"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "properties": {
        "finding_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "symptom": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "severity": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "evidence_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "affected_component_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "finding_id",
        "check_id",
        "symptom",
        "severity",
        "evidence_ids",
        "affected_component_ids",
        "blocking"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "validation_plan_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "VALIDATION"
              ]
            }
          }
        },
        "target_and_execution": {
          "$ref": "#/$defs/target_and_execution"
        },
        "check_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check_result"
          }
        },
        "coverage_summary": {
          "type": "object",
          "properties": {
            "covered_check_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
            },
            "unverified_check_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
            },
            "sufficient": {
              "type": "boolean"
            }
          },
          "required": [
            "covered_check_ids",
            "unverified_check_ids",
            "sufficient"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "gate_assessment": {
          "type": "object",
          "properties": {
            "gate": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/gate"
            },
            "scope": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/validation_scope_level"
            },
            "state": {
              "enum": [
                "SATISFIED",
                "BLOCKED"
              ]
            },
            "blocking_check_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
            },
            "rationale": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            }
          },
          "required": [
            "gate",
            "scope",
            "state",
            "blocking_check_ids",
            "rationale"
          ],
          "additionalProperties": false
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/evidence_ref"
          }
        },
        "revalidation_guidance": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "validation_plan_ref",
        "target_and_execution",
        "check_results",
        "coverage_summary",
        "findings",
        "gate_assessment",
        "evidence_refs",
        "revalidation_guidance"
      ],
      "additionalProperties": false
    }
  }
}
