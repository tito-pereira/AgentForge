{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:project",
  "title": "Corinthos Project Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "PROJECT"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "PROJECT_MANAGER"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "properties": {
        "requirement_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/criterion"
          },
          "minItems": 1
        }
      },
      "required": [
        "requirement_id",
        "description",
        "acceptance_criteria"
      ],
      "additionalProperties": false
    },
    "constraint": {
      "type": "object",
      "properties": {
        "constraint_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "constraint_id",
        "description"
      ],
      "additionalProperties": false
    },
    "structural_proposal": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "SUGGESTION",
            "REQUIREMENT"
          ]
        },
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "requirement_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "constraint_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        }
      },
      "required": [
        "proposal_id",
        "kind",
        "description",
        "requirement_ids",
        "constraint_ids"
      ],
      "additionalProperties": false
    },
    "negotiated_decision": {
      "type": "object",
      "properties": {
        "decision_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "proposal_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "decision": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "rationale": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "decision_id",
        "proposal_ids",
        "decision",
        "rationale"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "vision": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "scope": {
          "type": "object",
          "properties": {
            "included": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
            },
            "excluded": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            },
            "assumptions": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            },
            "risks": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "included",
            "excluded",
            "assumptions",
            "risks"
          ],
          "additionalProperties": false
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "minItems": 1
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "success_criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/criterion"
          },
          "minItems": 1
        },
        "structural_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structural_proposal"
          }
        },
        "negotiated_decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negotiated_decision"
          }
        }
      },
      "required": [
        "vision",
        "scope",
        "requirements",
        "constraints",
        "success_criteria",
        "structural_proposals",
        "negotiated_decisions"
      ],
      "additionalProperties": false
    }
  }
}
