{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:common",
  "title": "Shared Nukytera contract definitions",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "date_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "text_list": {
      "type": "array",
      "items": {
        "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
      }
    },
    "nonempty_text_list": {
      "type": "array",
      "items": {
        "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
      },
      "minItems": 1
    },
    "identifier_list": {
      "type": "array",
      "items": {
        "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "contract_type": {
      "enum": [
        "PROJECT",
        "WORKFLOW",
        "MODULE",
        "TECHNOLOGY_DECISION",
        "VALIDATION",
        "VALIDATION_RESULT",
        "EVIDENCE_REPORT",
        "PROJECT_REVISION_REQUEST"
      ]
    },
    "contract_ref": {
      "type": "object",
      "properties": {
        "contract_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "revision_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "contract_type": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_type"
        },
        "project_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        }
      },
      "required": [
        "contract_id",
        "revision_id",
        "contract_type",
        "project_id"
      ],
      "additionalProperties": false
    },
    "contract_ref_list": {
      "type": "array",
      "items": {
        "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
      },
      "uniqueItems": true
    },
    "standard_ref": {
      "type": "object",
      "properties": {
        "standard_id": {
          "const": "nukytera-standard"
        },
        "version": {
          "const": "0.1"
        }
      },
      "required": [
        "standard_id",
        "version"
      ],
      "additionalProperties": false
    },
    "standard_rule_ref": {
      "type": "object",
      "properties": {
        "standard_id": {
          "const": "nukytera-standard"
        },
        "version": {
          "const": "0.1"
        },
        "rule_id": {
          "enum": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ]
        }
      },
      "required": [
        "standard_id",
        "version",
        "rule_id"
      ],
      "additionalProperties": false
    },
    "obligation_ref": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "contract_ref": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
            },
            "obligation_id": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            }
          },
          "required": [
            "contract_ref",
            "obligation_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "standard_rule_ref": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/standard_rule_ref"
            }
          },
          "required": [
            "standard_rule_ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "criterion": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "criterion": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "criterion_id",
        "criterion"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "engine": {
          "enum": [
            "PROJECT_MANAGER",
            "WORKFLOW",
            "VALIDATION",
            "REPORT"
          ]
        },
        "actor_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "source": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "engine",
        "actor_id",
        "source"
      ],
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "HUMAN",
            "DELEGATED"
          ]
        },
        "approval_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "actor_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        }
      },
      "required": [
        "kind",
        "approval_id",
        "actor_id"
      ],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "properties": {
        "contract_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "revision_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "contract_type": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_type"
        },
        "project_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "schema_version": {
          "const": "1.0"
        },
        "status": {
          "enum": [
            "DRAFT",
            "PUBLISHED"
          ]
        },
        "created_at": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/date_time"
        },
        "supersedes": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "standard_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/standard_ref"
        },
        "provenance": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/provenance"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/approval"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_id",
        "revision_id",
        "contract_type",
        "project_id",
        "version",
        "schema_version",
        "status",
        "created_at",
        "supersedes",
        "standard_ref",
        "provenance",
        "approval"
      ],
      "additionalProperties": false
    },
    "envelope": {
      "type": "object",
      "properties": {
        "metadata": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/metadata"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "metadata",
        "payload"
      ],
      "additionalProperties": false
    },
    "validation_scope_level": {
      "enum": [
        "MODULE",
        "INTEGRATION",
        "CHECKPOINT",
        "PLAYTEST_MILESTONE",
        "PRODUCT"
      ]
    },
    "gate": {
      "enum": [
        "CHECKPOINT",
        "PLAYTEST_READINESS",
        "PRODUCT_VALIDATION"
      ]
    },
    "artifact_identity": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
        },
        "build_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "snapshot_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "artifact_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "commit"
          ]
        },
        {
          "required": [
            "build_id"
          ]
        },
        {
          "required": [
            "snapshot_id"
          ]
        }
      ]
    },
    "evidence_ref": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "evidence_kind": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
        },
        "artifact_identity": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/artifact_identity"
        },
        "execution_context": {
          "type": "object",
          "properties": {
            "validation_run_id": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            },
            "validation_plan_ref": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
              "properties": {
                "contract_type": {
                  "enum": [
                    "VALIDATION"
                  ]
                }
              }
            }
          },
          "required": [
            "validation_run_id",
            "validation_plan_ref"
          ],
          "additionalProperties": false
        },
        "verification_method": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "evaluator_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,126}[A-Za-z0-9_-])?(?:/[A-Za-z0-9](?:[A-Za-z0-9_.-]{0,126}[A-Za-z0-9_-])?)*(?![\\s\\S])",
          "description": "Relative, slash-separated path under the private artifact directory."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        }
      },
      "required": [
        "evidence_id",
        "evidence_kind",
        "check_id",
        "source_ref",
        "artifact_identity",
        "execution_context",
        "verification_method",
        "evaluator_ref",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
