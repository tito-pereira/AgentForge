{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:technology-decision",
  "title": "Nukytera Technology Decision Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "TECHNOLOGY_DECISION"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "WORKFLOW"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "if": {
    "properties": {
      "metadata": {
        "properties": {
          "status": {
            "const": "PUBLISHED"
          }
        }
      }
    }
  },
  "then": {
    "properties": {
      "payload": {
        "properties": {
          "ai_recommendations": {
            "minItems": 1
          },
          "selected_option": {
            "$ref": "#/$defs/selected_option"
          }
        }
      }
    }
  },
  "$defs": {
    "ranked_option": {
      "type": "object",
      "properties": {
        "option_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "technology": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "suitability_rationale": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "advantages": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "limitations": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "risks": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "compatibility_notes": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "option_id",
        "technology",
        "rank",
        "suitability_rationale",
        "advantages",
        "limitations",
        "risks",
        "compatibility_notes"
      ],
      "additionalProperties": false
    },
    "selected_option": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "RECOMMENDED"
            },
            "option_id": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            }
          },
          "required": [
            "source",
            "option_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "HUMAN"
            },
            "technology": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "feasibility_rationale": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            }
          },
          "required": [
            "source",
            "technology",
            "feasibility_rationale"
          ],
          "additionalProperties": false
        }
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "decision_scope": {
          "type": "object",
          "properties": {
            "subject": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "objective": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "module_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list",
              "minItems": 1
            }
          },
          "required": [
            "subject",
            "objective",
            "module_ids"
          ],
          "additionalProperties": false
        },
        "decision_drivers": {
          "type": "object",
          "properties": {
            "source_refs": {
              "type": "array",
              "items": {
                "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
              }
            },
            "factors": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
            }
          },
          "required": [
            "source_refs",
            "factors"
          ],
          "additionalProperties": false
        },
        "ai_recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ranked_option"
          },
          "maxItems": 5
        },
        "selected_option": {
          "anyOf": [
            {
              "$ref": "#/$defs/selected_option"
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_rationale": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "compatibility_requirements": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "verification_criteria": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/criterion"
          },
          "minItems": 1
        }
      },
      "required": [
        "decision_scope",
        "decision_drivers",
        "ai_recommendations",
        "selected_option",
        "decision_rationale",
        "compatibility_requirements",
        "verification_criteria"
      ],
      "additionalProperties": false
    }
  }
}
