{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:module",
  "title": "Nukytera Module Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "MODULE"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "WORKFLOW"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "provided_interface": {
      "type": "object",
      "properties": {
        "interface_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "interface_revision": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "interface_type": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "inputs": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "outputs": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "errors": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "side_effects": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "behavioral_guarantees": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "interface_id",
        "interface_revision",
        "interface_type"
      ],
      "additionalProperties": false
    },
    "consumed_interface": {
      "type": "object",
      "properties": {
        "provider_module_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "provider_contract_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "MODULE"
              ]
            }
          }
        },
        "interface_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "required_interface_revision": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        }
      },
      "required": [
        "provider_module_id",
        "provider_contract_ref",
        "interface_id",
        "required_interface_revision"
      ],
      "additionalProperties": false
    },
    "obligation_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
        },
        "criterion": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "verification_methods": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "evidence_required": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "source_ref",
        "criterion",
        "verification_methods",
        "evidence_required",
        "blocking"
      ],
      "additionalProperties": false
    },
    "interface_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "provider_module_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "interface_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "interface_revision": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "criterion": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "verification_methods": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "evidence_required": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "provider_module_id",
        "interface_id",
        "interface_revision",
        "criterion",
        "verification_methods",
        "evidence_required",
        "blocking"
      ],
      "additionalProperties": false
    },
    "quality_check": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "category": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "standard_rule_ref": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/standard_rule_ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "criterion": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "verification_methods": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "evidence_required": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "check_id",
        "category",
        "standard_rule_ref",
        "criterion",
        "verification_methods",
        "evidence_required",
        "blocking"
      ],
      "additionalProperties": false
    },
    "verification_spec": {
      "type": "object",
      "properties": {
        "requirement_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation_check"
          }
        },
        "constraint_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation_check"
          }
        },
        "interface_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interface_check"
          }
        },
        "quality_checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality_check"
          }
        },
        "evidence_expectations": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        }
      },
      "required": [
        "requirement_checks",
        "constraint_checks",
        "interface_checks",
        "quality_checks",
        "evidence_expectations"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "module_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "purpose_and_boundaries": {
          "type": "object",
          "properties": {
            "purpose": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "responsibilities": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
            },
            "exclusions": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "purpose",
            "responsibilities",
            "exclusions"
          ],
          "additionalProperties": false
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
          }
        },
        "constraint_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
          }
        },
        "provided_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provided_interface"
          }
        },
        "consumed_interfaces": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consumed_interface"
          }
        },
        "technology_decision_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
            "properties": {
              "contract_type": {
                "enum": [
                  "TECHNOLOGY_DECISION"
                ]
              }
            }
          }
        },
        "verification_spec": {
          "$ref": "#/$defs/verification_spec"
        }
      },
      "required": [
        "module_id",
        "purpose_and_boundaries",
        "requirement_refs",
        "constraint_refs",
        "provided_interfaces",
        "consumed_interfaces",
        "technology_decision_refs",
        "verification_spec"
      ],
      "additionalProperties": false
    }
  }
}
