{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:project-revision-request",
  "title": "Nukytera Project Revision Request",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "PROJECT_REVISION_REQUEST"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "WORKFLOW"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "affected_proposals": {
      "type": "object",
      "properties": {
        "proposal_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "requirement_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "constraint_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "criterion_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        }
      },
      "required": [
        "proposal_ids",
        "requirement_ids",
        "constraint_ids",
        "criterion_ids"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "proposal_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "requirement_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "constraint_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "criterion_ids": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "inconsistency": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "confirmed_facts": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "uncertainties": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "kind": {
          "const": "STRUCTURAL_CONFLICT"
        }
      },
      "required": [
        "description",
        "confirmed_facts",
        "uncertainties",
        "kind"
      ],
      "additionalProperties": false
    },
    "evidence_index": {
      "type": "object",
      "properties": {
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
        },
        "evidence_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "limitations": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "source_ref",
        "evidence_ids",
        "description",
        "limitations"
      ],
      "additionalProperties": false
    },
    "alternative": {
      "type": "object",
      "properties": {
        "description": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "trade_offs": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "verification": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "documentation": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "risks": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "description",
        "trade_offs",
        "verification",
        "documentation",
        "risks"
      ],
      "additionalProperties": false
    },
    "alternatives": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alternative"
          }
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "options",
        "unavailable_reason"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "options": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "unavailable_reason": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
          }
        }
      }
    },
    "impact": {
      "type": "object",
      "properties": {
        "module_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "requirement_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "interface_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "technology_decision_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
            "properties": {
              "contract_type": {
                "enum": [
                  "TECHNOLOGY_DECISION"
                ]
              }
            }
          }
        },
        "checkpoint_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "milestone_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "build_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "regressions": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "documentation": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "risks": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        },
        "preserved_items": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "module_ids",
        "requirement_ids",
        "interface_ids",
        "technology_decision_refs",
        "checkpoint_ids",
        "milestone_ids",
        "build_ids",
        "regressions",
        "documentation",
        "risks",
        "preserved_items"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "request_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "project_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "base_contract_version": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "PROJECT"
              ]
            }
          }
        },
        "affected_proposals": {
          "$ref": "#/$defs/affected_proposals"
        },
        "inconsistencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inconsistency"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_index"
          },
          "minItems": 1
        },
        "alternatives": {
          "$ref": "#/$defs/alternatives"
        },
        "impact": {
          "$ref": "#/$defs/impact"
        }
      },
      "required": [
        "request_id",
        "project_id",
        "base_contract_version",
        "affected_proposals",
        "inconsistencies",
        "evidence",
        "alternatives",
        "impact"
      ],
      "additionalProperties": false
    }
  }
}
