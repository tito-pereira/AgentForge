{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:evidence-report",
  "title": "Nukytera Evidence & Report Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "EVIDENCE_REPORT"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "REPORT"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "version_and_delivery_lineage": {
      "type": "object",
      "properties": {
        "project_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "product_version": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "build_id": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "milestone_id": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "checkpoint_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "previous_version": {
          "anyOf": [
            {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            {
              "type": "null"
            }
          ]
        },
        "technical_validation": {
          "enum": [
            "NOT_VERIFIED",
            "VALIDATED",
            "BLOCKED"
          ]
        },
        "delivery": {
          "enum": [
            "NOT_DELIVERED",
            "DELIVERED"
          ]
        },
        "availability": {
          "type": "boolean"
        },
        "acceptance": {
          "enum": [
            "NOT_REVIEWED",
            "ACCEPTED",
            "WITH_RESERVATIONS"
          ]
        }
      },
      "required": [
        "project_id",
        "product_version",
        "build_id",
        "milestone_id",
        "checkpoint_ids",
        "previous_version",
        "technical_validation",
        "delivery",
        "availability",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "commandment_observation": {
      "type": "object",
      "properties": {
        "evidence_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
        },
        "gaps": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "evidence_ids",
        "gaps"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "evidence_ids": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "gaps": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "feedback": {
      "type": "object",
      "properties": {
        "feedback_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "build_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "milestone_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "status": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        }
      },
      "required": [
        "feedback_id",
        "build_id",
        "milestone_id",
        "status"
      ],
      "additionalProperties": false
    },
    "metric": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "definition": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "value": {
          "type": "number"
        },
        "denominator": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
        }
      },
      "required": [
        "name",
        "definition",
        "value",
        "denominator",
        "source_ref"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "report_scope": {
          "type": "object",
          "properties": {
            "target_id": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
            },
            "audience": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "as_of": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/date_time"
            },
            "kind": {
              "enum": [
                "CHECKPOINT",
                "MILESTONE",
                "PRODUCT",
                "HISTORY",
                "EVOLUTION"
              ]
            },
            "objective": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "boundaries": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "target_id",
            "audience",
            "as_of",
            "kind",
            "objective",
            "boundaries"
          ],
          "additionalProperties": false
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "version_and_delivery_lineage": {
          "$ref": "#/$defs/version_and_delivery_lineage"
        },
        "execution_and_validation_digest": {
          "type": "object",
          "properties": {
            "validation_result_refs": {
              "type": "array",
              "items": {
                "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
                "properties": {
                  "contract_type": {
                    "enum": [
                      "VALIDATION_RESULT"
                    ]
                  }
                }
              }
            },
            "summary": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "blocked_check_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
            }
          },
          "required": [
            "validation_result_refs",
            "summary",
            "blocked_check_ids"
          ],
          "additionalProperties": false
        },
        "engineering_quality_and_documentation": {
          "type": "object",
          "properties": {
            "M1": {
              "$ref": "#/$defs/commandment_observation"
            },
            "M2": {
              "$ref": "#/$defs/commandment_observation"
            },
            "M3": {
              "$ref": "#/$defs/commandment_observation"
            },
            "M4": {
              "$ref": "#/$defs/commandment_observation"
            },
            "M5": {
              "$ref": "#/$defs/commandment_observation"
            }
          },
          "required": [
            "M1",
            "M2",
            "M3",
            "M4",
            "M5"
          ],
          "additionalProperties": false
        },
        "decisions_and_change_history": {
          "type": "object",
          "properties": {
            "decision_ids": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list"
            },
            "change_refs": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref_list"
            },
            "notes": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "decision_ids",
            "change_refs",
            "notes"
          ],
          "additionalProperties": false
        },
        "artifact_and_evidence_index": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/evidence_ref"
          }
        },
        "feedback_and_acceptance": {
          "type": "object",
          "properties": {
            "review_approval_id": {
              "anyOf": [
                {
                  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
                },
                {
                  "type": "null"
                }
              ]
            },
            "feedback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/feedback"
              }
            }
          },
          "required": [
            "review_approval_id",
            "feedback"
          ],
          "additionalProperties": false
        },
        "risks_metrics_and_next_actions": {
          "type": "object",
          "properties": {
            "risks": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            },
            "metrics": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/metric"
              }
            },
            "next_actions": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "risks",
            "metrics",
            "next_actions"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "report_scope",
        "source_refs",
        "version_and_delivery_lineage",
        "execution_and_validation_digest",
        "engineering_quality_and_documentation",
        "decisions_and_change_history",
        "artifact_and_evidence_index",
        "feedback_and_acceptance",
        "risks_metrics_and_next_actions"
      ],
      "additionalProperties": false
    }
  }
}
