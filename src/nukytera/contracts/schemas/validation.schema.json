{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nukytera:contracts:1.0:validation",
  "title": "Nukytera Validation Contract",
  "$comment": "SPDX-License-Identifier: MPL-2.0",
  "$ref": "urn:nukytera:contracts:1.0:common#/$defs/envelope",
  "properties": {
    "metadata": {
      "properties": {
        "contract_type": {
          "const": "VALIDATION"
        },
        "provenance": {
          "properties": {
            "engine": {
              "const": "VALIDATION"
            }
          }
        }
      }
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "validation_scope": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/validation_scope_level"
        },
        "target_ids": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier_list",
          "minItems": 1
        },
        "target_contract_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
          "properties": {
            "contract_type": {
              "enum": [
                "PROJECT",
                "WORKFLOW",
                "MODULE"
              ]
            }
          }
        },
        "objective": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "boundaries": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
        }
      },
      "required": [
        "level",
        "target_ids",
        "target_contract_ref",
        "objective",
        "boundaries"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "MODULE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_contract_ref": {
                "properties": {
                  "contract_type": {
                    "const": "MODULE"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "INTEGRATION",
                  "CHECKPOINT",
                  "PLAYTEST_MILESTONE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_contract_ref": {
                "properties": {
                  "contract_type": {
                    "const": "WORKFLOW"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "enum": [
                  "PRODUCT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_contract_ref": {
                "properties": {
                  "contract_type": {
                    "const": "PROJECT"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "matrix_entry": {
      "type": "object",
      "properties": {
        "check_id": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/identifier"
        },
        "source_ref": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/obligation_ref"
        },
        "criterion": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "verification_method": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
        },
        "required_evidence": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "gate_classification": {
          "enum": [
            "MANDATORY",
            "OPTIONAL"
          ]
        }
      },
      "required": [
        "check_id",
        "source_ref",
        "criterion",
        "verification_method",
        "required_evidence",
        "gate_classification"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "properties": {
        "validation_scope": {
          "$ref": "#/$defs/validation_scope"
        },
        "source_contract_refs": {
          "type": "array",
          "items": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
            "properties": {
              "contract_type": {
                "enum": [
                  "PROJECT",
                  "WORKFLOW",
                  "MODULE",
                  "TECHNOLOGY_DECISION"
                ]
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true,
          "contains": {
            "$ref": "urn:nukytera:contracts:1.0:common#/$defs/contract_ref",
            "properties": {
              "contract_type": {
                "enum": [
                  "PROJECT"
                ]
              }
            }
          }
        },
        "verification_matrix": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/matrix_entry"
          },
          "minItems": 1
        },
        "execution_plan": {
          "type": "object",
          "properties": {
            "procedures": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
            },
            "environment": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            },
            "tools": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            },
            "conditions": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            },
            "dependencies": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text_list"
            }
          },
          "required": [
            "procedures",
            "environment",
            "tools",
            "conditions",
            "dependencies"
          ],
          "additionalProperties": false
        },
        "independence_policy": {
          "type": "object",
          "properties": {
            "self_certification": {
              "const": false
            },
            "method": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/text"
            }
          },
          "required": [
            "self_certification",
            "method"
          ],
          "additionalProperties": false
        },
        "evidence_requirements": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        },
        "gate_policy": {
          "type": "object",
          "properties": {
            "gate": {
              "$ref": "urn:nukytera:contracts:1.0:common#/$defs/gate"
            }
          },
          "required": [
            "gate"
          ],
          "additionalProperties": false
        },
        "trigger_and_revalidation_policy": {
          "$ref": "urn:nukytera:contracts:1.0:common#/$defs/nonempty_text_list"
        }
      },
      "required": [
        "validation_scope",
        "source_contract_refs",
        "verification_matrix",
        "execution_plan",
        "independence_policy",
        "evidence_requirements",
        "gate_policy",
        "trigger_and_revalidation_policy"
      ],
      "additionalProperties": false
    }
  }
}
